<mvc:View
		xmlns:c="sap.ui.core"
		controllerName="zfctplhrmsportal.controller.Leave.MyInfo.MyInfo"
		xmlns:mvc="sap.ui.core.mvc"
		xmlns:u="sap.ui.unified"
		xmlns="sap.m"
		xmlns:t="sap.ui.table"
		xmlns:f="sap.f"
		xmlns:layout="sap.ui.layout"
		height="100%">
		<f:DynamicPage id="dynamicPageId1" preserveHeaderStateOnScroll="true" headerExpanded="{/headerExpanded}" showFooter="true" fitContent="true">
			<!-- DynamicPage Title -->
			<f:title>

				<f:DynamicPageTitle>
					<f:heading>
						<Title text="My Info > Leave Register"/>
					</f:heading>
				</f:DynamicPageTitle>
			</f:title>

			<!-- DynamicPage Header -->
			<f:header>
				<f:DynamicPageHeader pinnable="true">
						<FlexBox
								alignItems="Start"
								justifyContent="SpaceBetween">
							<items>
								<Panel backgroundDesign="Transparent"  >
									<content>
										
										<layout:VerticalLayout class="sapUiTinyMargin" >
											
											<layout:VerticalLayout >
												<Text text="Note*: All leave marked in the muster for the selected year will be considered as consumed.
												  In addition, Adjustment/Encashment/In-Process (non-approved leave applications) entries will also be treated as consumed.
												  Any leave entered in Adjustment/Increment during the payroll process will be credited." />
											</layout:VerticalLayout>

											<layout:HorizontalLayout class="sapUiTinyMargin" >
											
												<layout:HorizontalLayout >
													<Label class="sapUiTinyMargin" text="Employee: "  required="true"/>
													<Input  class="sapUiTinyMargin" id="idEmployee" required="true" width="10rem" />		
												</layout:HorizontalLayout>

												<layout:HorizontalLayout  >																						
													<Label class="sapUiTinyMargin" text="For the Period:"  required="true"/>
													<ComboBox class="sapUiTinyMargin" id="idPeriod"  required="true">
														<c:Item key="2024" text="2024"/>
                        								<c:Item key="2025" text="2025"/>
														<c:Item key="2026" text="2026"/>
													</ComboBox>
												</layout:HorizontalLayout>

												<layout:HorizontalLayout >
													<Label  class="sapUiTinyMargin" text="Leave Type: " required="true"/>
													<ComboBox class="sapUiTinyMargin" id="idLeaveType"  required="true">
														<c:Item key="CL" text="Casual Leave"/>
                        								<c:Item key="SL" text="Sick Leave"/>
														<c:Item key="PL" text="Privilege Leave"/>
														<c:Item key="OL" text="Other Leave"/>
														<c:Item key="LWP" text="Leave Without pay"/>
														<c:Item key="CO" text="Comp. Leave Enjoy"/>
													</ComboBox>
												</layout:HorizontalLayout>	

											</layout:HorizontalLayout>										

											<layout:HorizontalLayout class="sapUiTinyMargin" >
												<CheckBox text="Get Report From Archive Data" />
											</layout:HorizontalLayout>

                                            <layout:VerticalLayout class="sapUiTinyMargin">
												<layout:HorizontalLayout class="sapUiTinyMargin" >
													<Button class="sapUiTinyMargin" text="View" press="onViewPress"/>
                    								<Button class="sapUiTinyMargin" text="Reset" press="onResetPress"/>
												</layout:HorizontalLayout>
											</layout:VerticalLayout>

										</layout:VerticalLayout>

									</content>
								</Panel>
							</items>
						</FlexBox>
				</f:DynamicPageHeader>
			</f:header>

			<f:content>
				<t:Table
						rows="{Order_Details}"
						selectionMode="None"
						rowMode="Auto">
					<t:extension>
						<OverflowToolbar style="Clear">
							<Title text="Employee:"/>
						</OverflowToolbar>
					</t:extension>
					<t:columns>
						<t:Column width="3rem" hAlign="Left">
							<Label text="+/-" />
							<t:template>
								<Text text="{OrderID}"/>
							</t:template>
						</t:Column>
						<t:Column width="11rem" hAlign="Left">
							<Label text="Leave Type" />
							<t:template>
								<Text text="{ProductID}"/>
							</t:template>
						</t:Column>
						<t:Column width="11rem" hAlign="Left">
							<Label text="Opening Balance" />
							<t:template>
								<Text text="{UnitPrice}"/>
							</t:template>
						</t:Column>
						<t:Column width="11rem" hAlign="Left">
							<Label text="Consumed Days" />
							<t:template>
								<Text text="{Quantity}"/>
							</t:template>
						</t:Column>
						<t:Column width="11rem" hAlign="Left">
							<Label text="Credit Days" />
							<t:template>
								<Text text="{Discount}"/>
							</t:template>
						</t:Column>
						<t:Column width="11rem" hAlign="Left">
							<Label text="Available Balance" />
							<t:template>
								<Text text="{OrderID}"/>
							</t:template>
						</t:Column>
						<t:Column width="11rem" hAlign="Left">
							<Label text="Tansaction Date" />
							<t:template>
								<Text text="{ProductID}"/>
							</t:template>
						</t:Column>
						<t:Column width="11rem" hAlign="Left">
							<Label text="Remark" />
							<t:template>
								<Text text="{UnitPrice}"/>
							</t:template>
						</t:Column>
					</t:columns>
				</t:Table>
			</f:content>
			<!-- DynamicPage Footer -->
			<!-- <f:footer>
				<OverflowToolbar>
					<ToolbarSpacer/>
					<Button type="Accept" text="Accept"/>
					<Button type="Reject" text="Reject"/>
				</OverflowToolbar>
			</f:footer> -->
		</f:DynamicPage>
</mvc:View>