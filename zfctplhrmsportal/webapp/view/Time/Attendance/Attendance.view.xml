<mvc:View
		xmlns:c="sap.ui.core"
		controllerName="zfctplhrmsportal.controller.Time.Attendance.Attendance"
		xmlns:mvc="sap.ui.core.mvc"
		xmlns:u="sap.ui.unified"
		xmlns="sap.m"
		xmlns:t="sap.ui.table"
		xmlns:f="sap.f"
		xmlns:layout="sap.ui.layout"
		height="100%">
		<f:DynamicPage id="dynamicPageId" preserveHeaderStateOnScroll="true" headerExpanded="{/headerExpanded}" showFooter="true" fitContent="true">
			<!-- DynamicPage Title -->
			<f:title>
				<f:DynamicPageTitle>
					<f:heading>
						<Title text="Attendance"/>
					</f:heading>
				</f:DynamicPageTitle>
			</f:title>

			<!-- DynamicPage Header -->
			<f:header>
				<f:DynamicPageHeader pinnable="true">
						<FlexBox
								alignItems="Start"
								justifyContent="SpaceBetween">
							<items>
								<Panel
										backgroundDesign="Transparent"
										class="sapUiNoContentPadding">
									<content>
										<layout:HorizontalLayout
												allowWrapping="true" class="sapUiMediumMarginEnd">
											<layout:VerticalLayout class="sapUiTinyMargin">
												<RadioButton text="Day Lock Entry" selected="false" />
											</layout:VerticalLayout>
											<layout:HorizontalLayout class="sapUiTinyMarginTop">
												<Label class="sapUiSmallMargin" text="Employee : *" labelFor="employee" />
												<Input class="sapUiTinyMarginTop" id="idemployee" required="true" />
											</layout:HorizontalLayout>
											<layout:HorizontalLayout class="sapUiTinyMarginTop">
												<Label class="sapUiSmallMargin" text="Employee Code :" labelFor="employeecode" />
												<Input class="sapUiTinyMarginTop" id="idemployeecode" required="false" />
											</layout:HorizontalLayout>
											<layout:HorizontalLayout class="sapUiTinyMarginTop">
												<Label class="sapUiSmallMargin" text="For the Period :" labelFor="employeecode" />
												<Input class="sapUiTinyMarginTop" id="idfortheperiod" required="false" />
											</layout:HorizontalLayout>
											<layout:VerticalLayout class="sapUiTinyMargin">
												<RadioButton text="Get Report From Archive Data" selected="false" />
											</layout:VerticalLayout>
											<layout:HorizontalLayout class="sapUiTinyMarginTop">
												<Button class="sapUiTinyMargin" text="refresh" icon="sap-icon://refresh" type="Attention"></Button>
											</layout:HorizontalLayout>
										</layout:HorizontalLayout>
									</content>
								</Panel>
							</items>
						</FlexBox>
				</f:DynamicPageHeader>
			</f:header>

			<f:content>
				<t:Table
						rows="{/Attendance}"
						selectionMode="None"
						rowMode="Auto">
					<t:extension>
						<OverflowToolbar style="Clear">
							<Title text="Attendance"/>
							<ToolbarSpacer/>
								<Button text="Export PDF" icon="sap-icon://action" type="Accept"/>
						</OverflowToolbar>
					</t:extension>
					<t:columns>
						<t:Column width="11rem">
							<Label text="Date" />
							<t:template>
								<Input text="{Date}"/>
							</t:template>
						</t:Column>
						<t:Column width="11rem">
							<Label text="Day" />
							<DatePicker
							id="iddate"
							value="{
								'path':'/Date',
								'type':'sap.ui.model.type.Date',
								'formatOptions': {
									'pattern': 'dd-mm-yyyy'
								}
							}"
							change="handleChange"
							class="sapUiSmallMarginBottom"/>
						</t:Column>
						<t:Column width="11rem">
							<Label text="Shift Code" />
							<t:template>
								<Label text="{ShiftCode}" />
							</t:template>
						</t:Column>
						<t:Column width="11rem">
							<Label text="Shift InTime" />
							<t:template>
								<Label text="{ShiftInTime}" />
							</t:template>
						</t:Column>
						<t:Column width="11rem">
							<Label text="Shift OutTime" />
							<t:template>
								<Label text="{ShiftOutTime}" />
							</t:template>
						</t:Column>
						<t:Column width="11rem">
							<Label text="InTime" />
							<t:template>
								<Label text="{InTime}" />
							</t:template>
						</t:Column>
						<t:Column width="11rem">
							<Label text="OutTime" />
							<t:template>
								<Label text="{OutTime}" />
							</t:template>
						</t:Column>
						<t:Column width="11rem">
							<Label text="User Type1" />
							<t:template>
								<Label text="{UserType1}" />
							</t:template>
						</t:Column>
						<t:Column width="11rem">
							<Label text="User Type2" />
							<t:template>
								<Label text="{UserType2}" />
							</t:template>
						</t:Column>
						<t:Column width="11rem">
							<Label text="Portion" />
							<t:template>
								<Label text="{Portion}" />
							</t:template>
						</t:Column>
						<t:Column width="11rem" hAlign="Center">
							<Label text="Total Hours" />
							<t:template>
								<Label text="{TotalHours}" />
							</t:template>
						</t:Column>
						<t:Column width="11rem" hAlign="Center">
							<Label text="LateMark" />
							<t:template>
								<Label text="{LateMark}" />
							</t:template>
						</t:Column>
						<t:Column width="11rem" hAlign="Center">
							<Label text="InLateMark" />
							<t:template>
								<Label text="{InLateMark}" />
							</t:template>
						</t:Column>
					</t:columns>
				</t:Table>
			</f:content>
			<!-- DynamicPage Footer -->
			<!-- <f:footer>
				<OverflowToolbar>
					<ToolbarSpacer/>
					<Button type="Accept" text="Accept"/>
					<Button type="Reject" text="Reject"/>
				</OverflowToolbar>
			</f:footer> -->
		</f:DynamicPage>
</mvc:View>